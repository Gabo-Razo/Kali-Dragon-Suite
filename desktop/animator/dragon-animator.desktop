[Desktop Entry]
Type=Application
Name=Dragon Window Animator
Comment=Kali Dragon Suite - 60 FPS Window Animation Daemon
Exec=sh -c 'sleep 1; python3 "$HOME/.local/bin/dragon-window-animator.py"'
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-Override=true
